          </component>
        </children>
      </grid>
      <scrollpane id="749d3" binding="statisticsScrollPane">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="87bd" class="javax.swing.JTable" binding="statisticsTable">
            <constraints/>
            <properties/>
          </component>
        </children>
